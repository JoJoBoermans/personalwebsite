---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import GuideCard from '../../components/astro/GuideCard.astro';
const guides=[
  ['How to Measure a Shelf for Storage Bins','Inside dimensions, clear openings and practical measurement margins.','/measurement-guide/'],
  ['Shelf Space Calculator','Why usable front area, depth and access matter more than volume alone.','/guides/shelf-space-calculator/'],
  ['Pantry Bin Planner','A focused process for planning storage bins in a pantry.','/guides/pantry-bin-planner/'],
  ['How Many Storage Bins Fit on a Shelf?','Work through width, rotation, depth and mixed sizes.','/guides/how-many-storage-bins-fit/'],
  ['Storage Bin Size Guide','Understand handles, lids, tapered walls and outside dimensions.','/guides/storage-bin-size-guide/'],
  ['Cabinet Storage Layout Planner','Plan an existing cabinet opening without redesigning the cabinet.','/guides/cabinet-storage-layout-planner/']
];
const pageUrl = new URL('/guides/', Astro.site ?? Astro.url).toString();
const homeUrl = new URL('/', Astro.site ?? Astro.url).toString();
const structuredData = [
  {
    '@context':'https://schema.org',
    '@type':'CollectionPage',
    name:'ShelfSketch Storage Planning Guides',
    description:'Practical guides for measuring shelves, comparing storage-bin sizes and planning usable layouts.',
    url:pageUrl,
    hasPart: guides.map(([name, description, href]) => ({ '@type':'Article', name, description, url:new URL(href, Astro.site ?? Astro.url).toString() })),
  },
  {
    '@context':'https://schema.org',
    '@type':'BreadcrumbList',
    itemListElement:[
      { '@type':'ListItem', position:1, name:'Home', item:homeUrl },
      { '@type':'ListItem', position:2, name:'Guides', item:pageUrl },
    ],
  },
];
---
<BaseLayout title="Storage Planning Guides" description="Practical guides for measuring shelves, comparing storage-bin sizes and planning usable layouts." canonicalPath="/guides/" {structuredData}>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Guides'}]} />
  <header class="page-hero site-shell"><span class="eyebrow">ShelfSketch guides</span><h1>Measure well. Plan with fewer surprises.</h1><p>Focused guidance for the details a simple volume calculation misses: clear openings, outside product dimensions, depth, rotation and practical access.</p></header>
  <section class="site-shell section" style="padding-top:0"><div class="card-grid three">{guides.map(([title,description,href]) => <GuideCard {title} {description} {href} />)}</div></section>
</BaseLayout>
