---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = '/',
  imagePath = '/social/shelfsketch-og.png',
  noindex = false,
  structuredData,
} = Astro.props;
const siteName = 'ShelfSketch';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const image = new URL(imagePath, Astro.site ?? Astro.url);
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteName} visual shelf-layout planner`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={`${siteName} visual shelf-layout planner`} />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
