---
import SeoHead from '../components/astro/SeoHead.astro';
import SiteHeader from '../components/astro/SiteHeader.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
import ConsentManager from '../components/astro/ConsentManager.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { title, description, canonicalPath = '/', noindex = false, structuredData } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#22352f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <SeoHead {title} {description} {canonicalPath} {noindex} {structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <ConsentManager />
  </body>
</html>
