---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
interface Props { title: string; description: string; canonicalPath: string; eyebrow?: string; dateModified?: string; }
const { title, description, canonicalPath, eyebrow = 'ShelfSketch guide', dateModified = '2026-08-06' } = Astro.props;
const pageUrl = new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const homeUrl = new URL('/', Astro.site ?? Astro.url).toString();
const guidesUrl = new URL('/guides/', Astro.site ?? Astro.url).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    mainEntityOfPage: pageUrl,
    datePublished: '2026-08-06',
    dateModified,
    author: { '@type': 'Organization', name: 'ShelfSketch' },
    publisher: { '@type': 'Organization', name: 'ShelfSketch', url: homeUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: guidesUrl },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<BaseLayout {title} {description} {canonicalPath} {structuredData}>
  <Breadcrumbs items={[{label:'Home', href:'/'},{label:'Guides', href:'/guides/'},{label:title}]} />
  <header class="page-hero narrow-shell">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <article class="narrow-shell prose"><slot /></article>
</BaseLayout>
