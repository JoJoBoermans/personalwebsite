{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "scripts/type-stubs/react.d.ts",
    "src/types/domain.ts",
    "src/data/example-project.ts",
    "src/lib/project.ts",
    "src/lib/storage.ts",
    "src/lib/units.ts",
    "src/lib/validation.ts",
    "src/lib/packing/**/*.ts",
    "src/lib/editor/**/*.ts",
    "src/lib/io/**/*.ts",
    "src/components/planner/**/*.tsx"
  ],
  "exclude": [
    "src/lib/packing/__tests__/**",
    "src/lib/editor/__tests__/**",
    "src/lib/io/__tests__/**"
  ]
}
